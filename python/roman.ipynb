    "l1=[1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]\n",
    "l2=['M', 'CM', 'D', 'CD', 'C', 'XC', 'L', 'XL', 'X', 'IX', 'V', 'IV', 'I']\n",
    "n=int(input(\"enter number: \"))\n",
    "ans=''\n",
    "j=0\n",
    "while n>0:\n",
    "    for i in range(n//l1[j]):\n",
    "        ans=ans+l2[j]\n",
    "        n=n-l1[j]\n",
    "    j+=1\n",
    "print(ans)"
